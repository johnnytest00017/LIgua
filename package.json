{
  "name": "lingua-mobile",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "add:android": "cap add android",
    "add:ios": "cap add ios",
    "assets": "capacitor-assets generate --iconBackgroundColor #0b0b0c --splashBackgroundColor #0b0b0c",
    "sync": "cap sync",
    "android": "cap sync android && bash scripts/patch-android.sh && cap open android",
    "ios": "cap sync ios && cap open ios",
    "patch": "bash scripts/patch-android.sh",
    "build:web": "node scripts/build-web.mjs",
    "verify:onnx": "node scripts/verify-onnx.mjs",
    "test": "node --test \"tests/*.test.mjs\""
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/filesystem": "^7.1.9",
    "@capacitor/ios": "^7.0.0",
    "@huggingface/tokenizers": "^0.2.0",
    "@xenova/transformers": "^2.17.2",
    "onnxruntime-web": "^1.30.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.0.0",
    "esbuild": "^0.28.2"
  }
}
